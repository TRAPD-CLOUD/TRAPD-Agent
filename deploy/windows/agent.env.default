# Service defaults. Without a backend URL the agent collects local telemetry.
TRAPD_OUTPUT=file
RUST_LOG=info
# The hosted MSI ships ca.crt, command_signing.pub and the backend URL; without
# TRAPD_ENROLL_TOKEN the agent pairs (Start menu: "Pair this computer with TRAPD").
# For a self-hosted backend provision ca.crt and command_signing.pub here, then:
# TRAPD_BACKEND_URL=https://backend.example.com
# TRAPD_ENROLL_TOKEN=<token> (optional; omit to pair)
