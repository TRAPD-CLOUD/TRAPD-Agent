<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="TRAPD Agent" Manufacturer="TRAPD" Version="$(var.Version)"
           UpgradeCode="0D18AC24-8CE9-4513-A1E5-889FD2A01D93" Scope="perMachine" InstallerVersion="500">
    <SummaryInformation Description="TRAPD Windows telemetry agent (x64)" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer TRAPD Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="VersionNT64" Message="TRAPD requires 64-bit Windows." />

    <!-- Hosted build only (build-msi.ps1 -TrustDir): the hosted backend is the
         default. An existing registry value (earlier install) and an explicit
         BACKENDURL=... on the command line both take precedence over it. -->
    <?ifdef DefaultBackendUrl?>
    <Property Id="BACKENDURL" Secure="yes" Value="$(var.DefaultBackendUrl)">
      <RegistrySearch Id="ExistingBackend" Root="HKLM" Key="SOFTWARE\TRAPD\Agent" Name="BackendUrl" Type="raw" Bitness="always64" />
    </Property>
    <?else?>
    <Property Id="BACKENDURL" Secure="yes">
      <RegistrySearch Id="ExistingBackend" Root="HKLM" Key="SOFTWARE\TRAPD\Agent" Name="BackendUrl" Type="raw" Bitness="always64" />
    </Property>
    <?endif?>
    <Property Id="ENROLLTOKEN" Secure="yes" Hidden="yes">
      <RegistrySearch Id="ExistingEnrollToken" Root="HKLM" Key="SOFTWARE\TRAPD\Agent" Name="EnrollToken" Type="raw" Bitness="always64" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TRAPD Agent">
        <Component Id="AgentService" Guid="CF0BCF0C-FB5C-4DD4-A872-1C16C7FAE06B" Bitness="always64">
          <File Id="AgentExe" Source="$(var.AgentExe)" Name="trapd-agent.exe" KeyPath="yes" DefaultVersion="$(var.Version)" />
          <ServiceInstall Id="InstallService" Name="trapd-agent" DisplayName="TRAPD Agent"
                          Description="TRAPD endpoint telemetry and detection agent"
                          Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
            <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                                ThirdFailureActionType="restart" ResetPeriodInDays="1" RestartServiceDelayInSeconds="10" />
          </ServiceInstall>
          <ServiceControl Id="ManageService" Name="trapd-agent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        </Component>
        <!-- Lives in Program Files (not user-writable): it is started elevated. -->
        <Component Id="PairScript" Guid="D33A716E-0180-4E99-BB29-0F79C3AD16B2" Bitness="always64">
          <File Id="PairScriptFile" Source="$(var.SourceDir)\pair.ps1" Name="pair.ps1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="TRAPD">
        <Component Id="PairShortcut" Guid="B4354B5F-DE7C-48F7-BDBB-2B58D832A4BF" Bitness="always64">
          <Shortcut Id="PairShortcutLink" Name="Pair this computer with TRAPD"
                    Description="Show the pairing code and open the TRAPD pairing page"
                    Target="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe"
                    Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[#PairScriptFile]&quot;"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
          <!-- Keep shortcut bookkeeping outside the credential key. MSI
               coalesces writes to a key; an unsecured first value can suppress
               the security descriptor on a later secured value. -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\TRAPD\Installer" Name="PairShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATADIR" Name="TRAPD">
        <Component Id="DataDirectory" Guid="136A6095-4BF6-48D3-9CF0-CBA31D045040" Permanent="yes" Bitness="always64">
          <CreateFolder><PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
        </Component>
        <Directory Id="CONFIGDIR" Name="config">
          <Component Id="ConfigDirectory" Guid="216B2CBE-ED4D-454C-AC9A-7C0E44A45C43" Permanent="yes" Bitness="always64">
            <CreateFolder><PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
          </Component>
          <Component Id="DefaultConfig" Guid="7C6D5625-F935-45E3-8A13-A6278F92D2C8" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
            <File Id="DefaultEnv" Source="$(var.SourceDir)\agent.env.default" Name="agent.env" KeyPath="yes" />
          </Component>
          <?ifdef TrustDir?>
          <!-- Hosted build only: public trust anchors of the hosted service.
               NeverOverwrite + Permanent, like agent.env: anchors an operator
               provisioned (self-hosted) are neither replaced nor removed. The
               directory ACL (SYSTEM/Administrators only) is inherited. -->
          <Component Id="TrustCa" Guid="11C6B491-5B19-4992-8D0C-4A76A2998CAB" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
            <File Id="TrustCaFile" Source="$(var.TrustDir)\ca.crt" Name="ca.crt" KeyPath="yes" />
          </Component>
          <Component Id="TrustCommandKey" Guid="19DD277F-FB2F-4CAB-BF83-55AEF98ED970" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
            <File Id="TrustCommandKeyFile" Source="$(var.TrustDir)\command_signing.pub" Name="command_signing.pub" KeyPath="yes" />
          </Component>
          <?ifdef HasReleaseKey?>
          <!-- Independent of the command key: a compromised backend can order
               an update but cannot mint a release the agent will install. -->
          <Component Id="TrustReleaseKey" Guid="5E3F6B58-1C0D-4B41-8A86-62C1B6C8E1D7" Permanent="yes" NeverOverwrite="yes" Bitness="always64">
            <File Id="TrustReleaseKeyFile" Source="$(var.TrustDir)\release_signing.pub" Name="release_signing.pub" KeyPath="yes" />
          </Component>
          <?endif?>
          <?endif?>
        </Directory>
        <Directory Id="STATEDIR" Name="state">
          <Component Id="StateDirectory" Guid="A7BD0384-9A98-4B66-BDA8-E1292C094696" Permanent="yes" Bitness="always64">
            <CreateFolder><PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
          </Component>
        </Directory>
        <Directory Id="LOGDIR" Name="logs">
          <Component Id="LogDirectory" Guid="CC125FE4-1CBB-459E-8C48-A1A8BEB91074" Permanent="yes" Bitness="always64">
            <CreateFolder><PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Component Id="RegistryConfig" Directory="INSTALLFOLDER" Guid="9625220B-260F-4E51-BFBE-476EF6BE1543" Permanent="yes" Bitness="always64">
      <RegistryValue Root="HKLM" Key="SOFTWARE\TRAPD\Agent" Name="Installed" Type="integer" Value="1" KeyPath="yes">
        <PermissionEx Sddl="D:P(A;CI;KA;;;SY)(A;CI;KA;;;BA)" />
      </RegistryValue>
    </Component>
    <Component Id="BackendConfig" Directory="INSTALLFOLDER" Guid="0C71EE73-B218-46C4-AE14-839BED9F71FC" Permanent="yes" Bitness="always64" Condition="BACKENDURL">
      <RegistryValue Root="HKLM" Key="SOFTWARE\TRAPD\Agent" Name="BackendUrl" Type="string" Value="[BACKENDURL]" KeyPath="yes" />
    </Component>
    <Component Id="EnrollmentConfig" Directory="INSTALLFOLDER" Guid="91605497-3A06-4D6A-90AA-C6857E11B074" Permanent="yes" Bitness="always64" Condition="ENROLLTOKEN">
      <RegistryValue Root="HKLM" Key="SOFTWARE\TRAPD\Agent" Name="EnrollToken" Type="string" Value="[ENROLLTOKEN]" KeyPath="yes" />
    </Component>

    <!-- MSI owns service registration. This verb only revokes agent decoys,
         after StopServices and before RemoveFiles; upgrades preserve decoys. -->
    <CustomAction Id="CleanupDecoys" FileRef="AgentExe" ExeCommand="cleanup" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="CleanupDecoys" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <Feature Id="Agent" Title="TRAPD Agent" Level="1">
      <ComponentRef Id="AgentService" /><ComponentRef Id="DataDirectory" /><ComponentRef Id="ConfigDirectory" />
      <ComponentRef Id="DefaultConfig" /><ComponentRef Id="StateDirectory" /><ComponentRef Id="LogDirectory" />
      <ComponentRef Id="RegistryConfig" /><ComponentRef Id="BackendConfig" /><ComponentRef Id="EnrollmentConfig" />
      <ComponentRef Id="PairScript" /><ComponentRef Id="PairShortcut" />
      <?ifdef TrustDir?>
      <ComponentRef Id="TrustCa" /><ComponentRef Id="TrustCommandKey" />
      <?ifdef HasReleaseKey?><ComponentRef Id="TrustReleaseKey" /><?endif?>
      <?endif?>
    </Feature>
  </Package>
</Wix>
